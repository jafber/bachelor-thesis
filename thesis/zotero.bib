	file = {Full Text PDF:C\:\\Users\\Jan\\Zotero\\storage\\JZVKEGTK\\Holtzman et al. - 2021 - Surface Form Competition Why the Highest Probability Answer Isn't Always Right.pdf:application/pdf},
