	file = {Full Text PDF:C\:\\Users\\Jan\\Zotero\\storage\\2ZCS5FWY\\Zeng et al. - 2023 - MR-GSM8K A Meta-Reasoning Benchmark for Large Language Model Evaluation.pdf:application/pdf},
}

@inproceedings{holtzman_surface_2021,
	address = {Online and Punta Cana, Dominican Republic},
	title = {Surface {Form} {Competition}: {Why} the {Highest} {Probability} {Answer} {Isn}'t {Always} {Right}},
