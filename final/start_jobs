#!/usr/bin/env bash
# From anywhere: final/start_jobs smoke|small|full [llm_judge|dc_pmi|both] [--arm]
# Submits one independent SLURM job per method/model combination; never uses arrays.
set -euo pipefail

if (( $# < 1 || $# > 3 )); then
    echo "Usage: $0 smoke|small|full [llm_judge|dc_pmi|both] [--arm]" >&2
    exit 2
fi
case "$1" in
    smoke) models=(4b); sample_size=4; time=00:30:00 ;;
    small) models=(4b 9b 27b); sample_size=100; time=08:00:00 ;;
    full) models=(4b 9b 27b); sample_size=; time=36:00:00 ;;
    *) echo "Unknown run size: $1 (expected smoke, small, or full)" >&2; exit 2 ;;
esac
size=$1
shift
method=both
method_set=false
arch=X86
for arg in "$@"; do
    case "$arg" in
        --arm)
            [[ $arch == X86 ]] || { echo "Duplicate --arm" >&2; exit 2; }
            arch=ARM ;;
        llm_judge|dc_pmi|both)
            [[ $method_set == false ]] || { echo "Method specified twice" >&2; exit 2; }
            method=$arg
            method_set=true ;;
        *) echo "Unknown argument: $arg" >&2; exit 2 ;;
    esac
done
case "$method" in
    llm_judge) methods=(llm_judge) ;;
    dc_pmi) methods=(dc_pmi) ;;
    both) methods=(llm_judge dc_pmi) ;;
esac

command -v sbatch >/dev/null || { echo "sbatch not found" >&2; exit 1; }
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
mkdir -p "$root/logs"
if [[ $arch == ARM ]]; then
    python=/sc/home/jan.berndt/conda3-arm/envs/better-nli-arm/bin/python
    constraint='ARCH:ARM&GPU_SKU:GH200'
    suffix=_arm
else
    python=/sc/home/jan.berndt/conda3/envs/better-nli/bin/python
    suffix=
fi

for model in "${models[@]}"; do
    case "$model" in
        4b) gpu_mem=40GB; ram=32G; batch_size=4 ;;
        9b) gpu_mem=40GB; ram=48G; batch_size=2 ;;
        27b) gpu_mem=80GB; ram=96G; batch_size=1 ;;
    esac
    for method in "${methods[@]}"; do
        if [[ $arch == X86 ]]; then constraint="ARCH:X86&GPU_MEM:${gpu_mem}"; fi
        args=("$python" -u run_experiment.py "$method"
              --model "Qwen/Qwen3.5-${model^^}"
              --batch-size "$batch_size"
              --cache "cache/${method}_qwen35_${model}${suffix}.sqlite"
              --results "runs/${method}_qwen35_${model}_${size}${suffix}.csv")
        if [[ -n "$sample_size" ]]; then args+=(--sample-size "$sample_size" --seed 42); fi
        printf -v command_line '%q ' "${args[@]}"

        sbatch --job-name="qwen35-${model}-${method}-${size}${suffix}" \
            --account=sci-demelo --partition=pot-hpi-gpu-batch \
            --constraint="$constraint" \
            --gpus=1 --nodes=1 --cpus-per-task=4 --mem="$ram" --time="$time" \
            --chdir="$root" --output="logs/${method}_qwen35_${model}_${size}${suffix}_%j.log" \
            --wrap="export TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1; exec ${command_line}"
    done
done
